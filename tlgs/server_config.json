{
	"app":{
		"document_root": "/etc/tlgs/contents",
		"upload_path": "/var/tlgs/uploads",
		"file_types": [
			"gif",
			"png",
			"jpg",
			"js",
			"css",
			"html",
			"ico",
			"swf",
			"xap",
			"apk",
			"cur",
			"xml",
			"gmi",
			"txt"
		],
		"use_implicit_page": true,
		"implicit_page": "index.gmi",
		"home_page": "index.gmi",
		"mime": {
			"text/gemini": ["gmi", "gemini"]
		},
		"handle_sig_term": true
	},
	"plugins": [
		{
			"name": "dremini::GeminiServerPlugin",
			"config": {
				"listeners": [
					{
						"key": "../../key.pem",
						"cert": "../../cert.pem",
						"ip": "0.0.0.0",
						"port": 1966
					}
				],
				"numThread": 3,
				"translate_to_html": true
			}
		},
		{
			"name": "spartoi::SpartanServerPlugin",
			"config": {
				"listeners": [
					{
						"ip": "0.0.0.0",
						"port": 3000
					}
				],
				"numThread": 3,
				"translate_to_html": true
			}
		}
	],
	"listeners": [
		{
			"ip": "0.0.0.0",
			"port": 8808
		}
	],
	"db_clients": [
		{
			"rdbms": "postgresql",
			"host": "127.0.0.1",
			"port": 5432,
			"dbname": "tlgs",
			"number_of_connections": 4,
			"timeout": 30
		}
	 ],
	 "custom_config": {
		 "tardis": {
			 "endpoint": "gemini://tardis.northwire.xyz",
			 "certificate": "../../tlgs-tardis-client-cert.pem",
			 "private_key": "../../tlgs-tardis-client-key.pem"
		 },
		 "tlgs": {
			 "ranking_algo": "fusion",
			 "fusion_graph_weight": 1.0,
			 "fusion_site_decay": 0.5,
			 "fusion_max_site_results_per_page": 2
		 }
	 }
}
